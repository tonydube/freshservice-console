# Your Freshservice subdomain: https://<this>.freshservice.com
FRESHSERVICE_DOMAIN=yourcompany
# API key from Freshservice: Profile settings -> "Your API Key"
FRESHSERVICE_API_KEY=
# Local port for the proxy server (UI in prod, API in dev)
SERVER_PORT=8787
# Optional: text appended to replies/notes (useful if the key is a shared/service agent)
REPLY_SIGNATURE=
# Optional: your agent email, used for the "My open" view (can also be set in the UI)
MY_AGENT_EMAIL=
